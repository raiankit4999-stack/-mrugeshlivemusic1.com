generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  metaTitle       String?
  metaDescription String?
  excerpt         String
  coverImage      String
  coverAlt        String
  bodyMarkdown    String
  tags            String[] @default([])
  readingTime     String
  published       Boolean  @default(true)
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([published, publishedAt])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  imageAlt    String
  eventDate   DateTime
  location    String
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, eventDate])
}

model GalleryImage {
  id          String   @id @default(cuid())
  imageUrl    String
  alt         String
  category    String?
  orientation String   @default("landscape")
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([published, order])
}

model Video {
  id        String   @id @default(cuid())
  title     String
  videoUrl  String
  posterUrl String
  type      String   @default("youtube")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([published, order])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  quote     String
  rating    Int      @default(5)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([published, order])
}

// Submissions from the public client onboarding / booking form
// (/onboarding). Filled in by prospective clients and reviewed by the
// admin from /admin/onboarding.
model OnboardingSubmission {
  id               String   @id @default(cuid())
  customerName     String
  address          String
  mobileNumber     String
  email            String?
  eventTypes       String[] @default([])
  eventDate        DateTime
  eventTime        String?
  eventVenue       String
  eventDuration    String?
  totalAmount      Int?
  advanceAmount    Int?
  remainingAmount  Int?
  paymentMode      String?
  paymentModeOther String?
  notes            String?
  termsAccepted    Boolean  @default(false)
  reviewed         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([reviewed, createdAt])
}

// Single-row table holding the current admin login. Falls back to the
// ADMIN_USERNAME / ADMIN_PASSWORD_HASH env vars until the admin changes
// their credentials from /admin/settings for the first time.
model AdminSettings {
  id           String   @id @default(cuid())
  username     String
  passwordHash String
  updatedAt    DateTime @updatedAt
}
