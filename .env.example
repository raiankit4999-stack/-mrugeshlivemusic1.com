# Postgres connection string. On Vercel: Project -> Storage -> connect a
# Postgres database (Neon/Vercel Postgres) -> the env vars are added
# automatically. Locally, copy the same value into a .env file.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Vercel Blob store, used for image/video uploads from the admin panel.
# Project -> Storage -> Create Database -> Blob. The token is added
# automatically to your Vercel project's env vars.
BLOB_READ_WRITE_TOKEN=""

# Admin login. Username is plain text; password must be a bcrypt hash, not
# the raw password. Generate one with:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(console.log)" "your-password-here"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Random secret used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
